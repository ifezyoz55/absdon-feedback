# ── Server ──────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/Absdon_feedback

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string_minimum_32_chars
JWT_EXPIRES_IN=8h

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Rate Limiting ─────────────────────────────────────
MAX_SUBMISSIONS_PER_DAY=5          # Per session/IP per 24h
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_MAX=100                 # General API rate limit

# ── Frontend ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
